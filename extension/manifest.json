{
  "manifest_version": 3,
  "name": "Hermes Brief",
  "version": "0.1.0",
  "description": "Save pages, X posts and videos to your own Hermes Agent and get a short brief of each. Ask Hermes about the page you're on.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "contextMenus", "bookmarks", "storage", "sidePanel", "notifications"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_title": "Hermes Brief", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "options_page": "options/options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "save-page": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Save this page to Hermes Brief" },
    "open-panel": { "suggested_key": { "default": "Alt+Shift+H" }, "description": "Ask Hermes about this page" }
  }
}
